        "type": "prometheus",
        "uid": "openshift"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (kube_pod_container_resource_requests{resource=\"cpu\"})",
          "legendFormat": "{{namespace}} {{pod}} {{node}} {{name}} {{persistentvolumeclaim}} {{instance}}"
